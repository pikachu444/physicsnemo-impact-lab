{
  "include": [
    "README.md",
    "*.py",
    "requirements*.txt",
    "environment_freeze.txt",
    "source_manifest.json",
    "run_commands.json",
    "execution_status.json",
    "metric_definitions.json",
    "runtime_dependency_closure.json",
    "inference_input_validation.json",
    "original_source_selfcheck.json",
    "install-compact.log",
    "pip-check.log",
    "cpu-smoke.log",
    "reader-selfcheck.log",
    "official-attempt*.log",
    "official-run-console.log",
    "inference_wrong_mesh_rejection.log",
    "gpu1024/{executed_source.py,metrics.json,training_history.csv,console.log,*.png,*.gif,transolver_cuda_checkpoint.pt,mesh_contract.json}",
    "fulltraining/{executed_source.py,metrics.json,training_history.csv,console.log,system_memory_samples.json,*.png,*.gif,transolver_cuda_checkpoint.pt,mesh_contract.json}",
    "capacity1024/{executed_source.py,metrics.json,training_history.csv,console.log,*.png,transolver_cuda_checkpoint.pt,mesh_contract.json}",
    "full_mesh/{*.json,*.py,console.log}",
    "capacity1024/probe/{*.json,*.py}",
    "{fulltraining,capacity1024}/inference_reuse/{inference_report.json,executed_inference.py,console.log}",
    "official_cpu_compat/{.hydra/*,*.log,checkpoints/*.mdlus,checkpoints/checkpoint.0.2.pt}"
  ],
  "exclude": [
    "**/*.npz",
    "**/*.vtp",
    "**/*.rad",
    "**/__pycache__/**",
    "**/output_*/**",
    "**/tensorboard_logs/**",
    "**/transolver_best_checkpoint.pt",
    "pip-physicsnemo.log",
    "pip-minimal-deps.log",
    "pip-remaining-deps.log",
    "pip-example-deps.log",
    "work/**",
    "local-run/**",
    "**/venv/**",
    "**/.venv/**",
    "**/*.whl"
  ],
  "meaning": "Selection guide for the parent repository packager, not shell glob syntax. Preserve originals locally. FEM-derived checkpoints and figures retain source attribution and declared noncommercial conditions."
}
